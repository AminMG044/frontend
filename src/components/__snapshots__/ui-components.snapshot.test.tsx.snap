exports[`stable UI snapshots > captures the creator search controls 1`] = `
<div>
  <div
    class="space-y-4 mb-8"
  >
    <div
      class="flex gap-4"
    >
      <div
        class="flex-1"
      >
        <input
          aria-label="Search creators"
          class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary"
          placeholder="Search creators..."
          type="text"
          value=""
        />
      </div>
      <label
        class="flex items-center gap-2 px-4 py-2 border rounded-lg cursor-pointer hover:bg-muted transition"
      >
        <input
          class="w-4 h-4"
          type="checkbox"
        />
        <span
          class="text-sm"
        >
          Verified only
        </span>
      </label>
    </div>
    <div
      class="flex flex-wrap items-end gap-3"
    >
      <div>
        <label
          class="text-xs font-medium text-muted-foreground"
          for="creator-min-earnings"
        >
          Min earnings
        </label>
        <input
          class="block mt-1 px-2 py-1.5 border rounded text-sm w-32"
          id="creator-min-earnings"
          min="0"
          placeholder="0"
          step="0.01"
          type="number"
          value=""
        />
      </div>
      <div>
        <label
          class="text-xs font-medium text-muted-foreground"
          for="creator-max-earnings"
        >
          Max earnings
        </label>
        <input
          class="block mt-1 px-2 py-1.5 border rounded text-sm w-32"
          id="creator-max-earnings"
          min="0"
          placeholder="Any"
          step="0.01"
          type="number"
          value=""
        />
      </div>
      <div>
        <label
          class="text-xs font-medium text-muted-foreground"
          for="creator-sort"
        >
          Sort by
        </label>
        <select
          class="block mt-1 px-2 py-1.5 border rounded text-sm"
          id="creator-sort"
        >
          <option
            value="trending"
          >
            Trending
          </option>
          <option
            value="newest"
          >
            Newest
          </option>
          <option
            value="alphabetical"
          >
            Alphabetical
          </option>
          <option
            value="earnings"
          >
            Earnings
          </option>
        </select>
      </div>
      <button
        class="px-3 py-1.5 text-sm border rounded hover:bg-muted transition"
        type="button"
      >
        Reset
      </button>
    </div>
  </div>
</div>
`;

exports[`stable UI snapshots > captures verification states 1`] = `
<div>
  <span
    class="group relative inline-flex flex-col"
  >
    <span
      aria-label="Verified status"
      class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold transition-smooth border border-success/20 bg-success/10 text-success cursor-help"
      role="status"
      tabindex="0"
      title="This creator has completed Dorisio identity verification. Verified Jan 1, 2026 · identity verification."
    >
      <svg
        aria-hidden="true"
        class="h-3.5 w-3.5 shrink-0"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
